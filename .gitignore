# Сцены и рендеры не хранятся: сцена — это код, всё пересобирается командой.
*.blend
*.blend1
*.exr
# Без ведущего слэша правило ловит renders/ на любой глубине. Прежнее
# `*/renders/` матчило ровно один уровень и молча перестало покрывать
# архивную копию примера, когда дерево стало глубже (аудит 2026-08-13).
renders/
_smoke/

# Чужие картинки-референсы: происхождение не задокументировано, а репозиторий
# публичный — держим локально, пока не будет ясности с правами.
references/

__pycache__/
*.py[cod]
.DS_Store

# Ключи API (Meshy и т.п.) — никогда не в репозиторий.
.secrets/
.env

